#encoding utf-8
#
# PEARL_BATTERY_INPUT
#
DEF PEARL_BATTERY_INPUT J 0 40 Y Y 1 F N
F0 "J" 0 300 50 H V C CNN
F1 "PEARL_BATTERY_INPUT" 0 -300 50 H V C CNN
DRAW
S -250 200 250 -200 0 1 12 f
X BATT_RAW_12V 1 500 100 250 L 45 45 1 1 P
X BATT_NEG 2 500 -100 250 L 45 45 1 1 P
ENDDRAW
ENDDEF
