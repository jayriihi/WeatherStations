#
# PEARL_HELTEC_V4
#
DEF PEARL_HELTEC_V4 U 0 40 Y Y 1 F N
F0 "U" 0 950 60 H V C CNN
F1 "PEARL_HELTEC_V4" 0 -950 60 H V C CNN
DRAW
S -650 800 650 -800 0 1 16 f
T 0 0 620 50 0 0 0 "ONBOARD: ESP32-S3R2 + SX1262 + OLED" Normal 0 C C
T 0 0 480 45 0 0 0 "LoRa NSS=8 DIO1=14 RST=12 BUSY=13" Normal 0 C C
T 0 0 360 45 0 0 0 "SPI SCK=9 MISO=11 MOSI=10" Normal 0 C C
T 0 0 240 45 0 0 0 "OLED SDA=17 SCL=18 RST=21 VEXT=36" Normal 0 C C
T 0 0 120 45 0 0 0 "Heartbeat LED GPIO35" Normal 0 C C
T 0 0 -420 45 0 0 0 "Onboard USB-C: programming + serial diagnostics" Normal 0 C C
X 5V J2.2 -900 600 250 R 45 45 1 1 W
X GND J2.1 -900 400 250 R 45 45 1 1 W
X GPIO7_UART_RX_WIRED J3.18 -900 0 250 R 45 45 1 1 I
X GPIO2_ADC J3.13 -900 -200 250 R 45 45 1 1 I
X LORA_IPEX RF 900 600 250 L 45 45 1 1 B
ENDDRAW
ENDDEF
